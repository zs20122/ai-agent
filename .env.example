# ============================================================
# AI 研发助手 Agent —— 环境变量模板
# 使用方法：复制本文件为 .env，然后填写真实值（.env 已被 .gitignore 忽略）
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME="AI 研发助手 Agent"
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
# 允许跨域的前端来源，多个用英文逗号分隔，* 表示全部
CORS_ORIGINS=*

# ---------- 大模型（OpenAI 兼容接口） ----------
# 必填：不填则 /api/v1/chat 会返回 503，服务本身仍可正常启动
OPENAI_API_KEY=
# 可选：使用中转/自建网关时填写，例如 https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------- Agent 行为 ----------
# 单个问题内最多允许的推理步数（决定递归上限，防止死循环）
MAX_AGENT_STEPS=6

# ---------- 工具 ----------
# 工作目录：list_project_files / read_project_file 只能访问该目录内部
WORKSPACE_DIR=data/workspace
# 是否启用命令行执行工具（高风险，默认关闭；开启后也仅允许白名单命令）
ENABLE_SHELL_TOOL=false

# ---------- 工具 · 知识库检索（RAG） ----------
# 是否启用 search_knowledge_base 工具（文档类问题会先检索再作答）
ENABLE_RAG_TOOL=true
# Embedding 模型：可填 HuggingFace 模型名，也可填本地模型目录（离线可用）
# 留空自动探测：优先本地缓存目录 ~/.cache/ai-agent/models/bge-small-zh-v1.5，否则用 BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL=
# 参与索引的目录（相对项目根，多个用英文逗号分隔）；只索引其中的 .md/.txt/.rst 文档
KNOWLEDGE_DIRS=.
# 分块与检索参数（分块越大上下文越全，越小定位越准）
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=1200

# ---------- 会话记忆 ----------
# 会话记忆后端：memory（进程内，重启即丢失）| sqlite（落盘到 SQLITE_DB_PATH，重启后可续聊）
CHECKPOINT_BACKEND=sqlite
# SQLite 会话库路径：相对路径按项目根目录解析，所在目录不存在会自动创建
SQLITE_DB_PATH=data/checkpoints.db
